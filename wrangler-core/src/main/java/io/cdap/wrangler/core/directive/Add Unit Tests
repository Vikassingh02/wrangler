@Test
public void testAggregation() {
    List<Row> rows = new ArrayList<>();
    rows.add(new Row().add("data_transfer_size", "1MB").add("response_time", "2s"));
    rows.add(new Row().add("data_transfer_size", "512KB").add("response_time", "3s"));

    String[] recipe = {
        "aggregate-stats :data_transfer_size :response_time total_size_mb total_time_sec"
    };

    List<Row> result = TestingRig.execute(recipe, rows);
    assertEquals(1, result.size());
    assertEquals(1.5, result.get(0).getValue("total_size_mb"));
    assertEquals(5.0, result.get(0).getValue("total_time_sec"));
}
